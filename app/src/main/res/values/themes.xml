<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ReadingQuiz" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/cafe_bg</item>
        <item name="android:navigationBarColor">@color/cafe_bg</item>
        <item name="android:windowBackground">@color/cafe_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.ReadingQuiz.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cafe_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ReadingQuiz</item>
    </style>
</resources>